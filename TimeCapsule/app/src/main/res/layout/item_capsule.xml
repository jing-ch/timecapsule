<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_capsule_card"
    android:elevation="2dp">

    <TextView
        android:id="@+id/tvCapsuleTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Birthday"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#222222" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivLockStatus"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Lock status"
            android:src="@android:drawable/ic_lock_lock" />

        <TextView
            android:id="@+id/tvCapsuleUnlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Locked until Jul 20, 2026"
            android:textSize="18sp"
            android:textColor="#555555" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="2d 5h 10m left"
        android:textSize="16sp"
        android:textColor="#777777" />

</LinearLayout>