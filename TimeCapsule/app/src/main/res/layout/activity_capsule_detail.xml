<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCFCFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_media_previous" />

        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Capsule Title"
            android:textColor="#222222"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- LOCKED SECTION -->
        <LinearLayout
            android:id="@+id/layoutLockedSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layoutLockedCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_capsule_card"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivLockedIcon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Locked"
                        android:src="@android:drawable/ic_lock_lock" />

                    <TextView
                        android:id="@+id/tvLockedStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Locked until Apr 20, 2026"
                        android:textColor="#444444"
                        android:textSize="18sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDetailCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="12d 4h 32m left"
                    android:textColor="#666666"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutWaitingArea"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_capsule_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:id="@+id/ivWaiting"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="Waiting"
                    android:src="@android:drawable/ic_lock_lock" />

                <TextView
                    android:id="@+id/tvWaitingMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="This memory is still sealed..."
                    android:textColor="#666666"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvWaitingDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Waiting..."
                    android:textColor="#9A9A9A"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLockedDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:lineSpacingExtra="4dp"
                android:text="The content, location, and media inside this capsule will be revealed once the unlock time arrives."
                android:textColor="#777777"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- UNLOCKED SECTION -->
        <LinearLayout
            android:id="@+id/layoutUnlockedSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvMessageLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Message"
                android:textColor="#666666"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_capsule_card"
                android:lineSpacingExtra="4dp"
                android:padding="20dp"
                android:text="Capsule content goes here"
                android:textColor="#333333"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvLocationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Location"
                android:textColor="#666666"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_capsule_card"
                android:padding="18dp"
                android:text="No location"
                android:textColor="#333333"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvMediaLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Media"
                android:textColor="#666666"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivDetailImage"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_capsule_card"
                android:contentDescription="Capsule image"
                android:padding="6dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutVideoPreview"
                android:layout_width="180dp"
                android:layout_height="140dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_capsule_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivVideoIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Play video"
                    android:src="@android:drawable/ic_media_play" />

                <TextView
                    android:id="@+id/tvVideoHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tap to play video"
                    android:textColor="#666666"
                    android:textSize="14sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/layoutVideoContainer"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_capsule_card"
                android:visibility="gone">

                <VideoView
                    android:id="@+id/vvDetailVideo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvNoMedia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_capsule_card"
                android:gravity="center"
                android:padding="24dp"
                android:text="No media"
                android:textColor="#888888"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>