<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="18dp"
            android:background="@android:color/transparent"
            android:padding="10dp"
            android:src="@android:drawable/ic_media_rew"
            app:tint="#222222"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="#222222" />

            <View
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="#E5E5E5" />

            <View
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="#E5E5E5" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="22dp"
            android:text="@string/create_a_capsule"
            android:textColor="#222222"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMediaTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/photos_videos"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutMedia"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginBottom="28dp"
            android:background="@android:drawable/editbox_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvAddIcon"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="#EEEEEE"
                android:gravity="center"
                android:text="@string/plus_photos"
                android:textColor="#888888"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAddMedia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/add_photos_videos"
                android:textColor="#444444"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTitleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/title"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCapsuleTitle"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="24dp"
            android:background="@android:drawable/edit_text"
            android:hint="@string/enter_a_title"
            android:paddingStart="18dp"
            android:paddingEnd="16dp"
            android:textColor="#222222"
            android:textColorHint="#B8B8B8"
            android:textSize="18sp"
            tools:ignore="Autofill,TextFields" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnNextStep"
            android:layout_width="190dp"
            android:layout_height="60dp"
            android:layout_gravity="center_horizontal"
            android:backgroundTint="#E6D9FF"
            android:text="@string/next_step_one"
            android:textAllCaps="false"
            android:textColor="#4B3F72"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>